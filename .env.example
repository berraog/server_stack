# Copy to .env, fill in, chmod 600. Never committed.
#   cp .env.example .env && chmod 600 .env && nano .env
# Compose reads .env from the directory of the compose file it runs, so this
# must live at ~/stack/.env — app repos do not get their own.

# ─ hardware ─ which overlay from hw/ this machine uses. Compose reads
# COMPOSE_FILE from this file, so it is the one line that differs between the
# mini PC and the Pi. Keep compose.yaml first.
#   Intel mini PC:  compose.yaml:hw/x86.yaml
#   Raspberry Pi:   compose.yaml:hw/pi.yaml
COMPOSE_FILE=compose.yaml:hw/x86.yaml

# ─ host ─
TZ=Europe/Stockholm
PUID=1000
PGID=1000

# ─ Cloudflare ─ Zero Trust > Networks > Tunnels > your tunnel > Docker
CLOUDFLARE_TUNNEL_TOKEN=

# ─ VPN ─ Nord dashboard > Manual setup > Service credentials (NOT the login)
NORDVPN_SERVICE_USER=
NORDVPN_SERVICE_PASS=

# ─ Prowlarr ─ Settings > General > Security > API Key
PROWLARR_API_KEY=

# ─ qBittorrent ─ the WebUI login the finder uses server-side
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# ─ torrent-finder ─ HTTP Basic for the finder's own UI. Invent these; they are
# unrelated to qBittorrent. Required because the finder is internet-facing.
UI_USERNAME=
UI_PASSWORD=

# ─ finder guard rails ─
MAX_TORRENT_SIZE_GB=25
MIN_FREE_SPACE_GB=20

# ─ Plex ─ Quick Sync: the host's render group id, which varies per install.
# Needed only by hw/x86.yaml; leave blank on the Pi.
#   getent group render | cut -d: -f3
RENDER_GID=

# first run only, expires in 4 minutes: https://plex.tv/claim
# PLEX_CLAIM=

# ─ matte-vm ─
MVM_KID_PIN=
MVM_PARENT_PASSWORD=
